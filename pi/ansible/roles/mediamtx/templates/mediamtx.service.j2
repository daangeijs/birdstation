# {{ ansible_managed }}
[Unit]
Description=MediaMTX RTSP server (birdmic)
Wants=network-online.target
After=network-online.target sound.target

[Service]
User={{ birdmic_mediamtx_user }}
Group={{ birdmic_mediamtx_user }}
SupplementaryGroups=audio
ExecStart=/usr/local/bin/mediamtx /etc/mediamtx/mediamtx.yml
Restart=always
RestartSec=2
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
